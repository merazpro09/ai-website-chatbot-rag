# OpenAI API key (https://platform.openai.com/api-keys). Never commit the real key.
OPENAI_API_KEY=sk-your-key-here

# Models (both configurable)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Crawling
SITEMAP_URL=https://example.com/sitemap.xml
MAX_PAGES=50
CRAWL_DELAY_MS=1000
# Optional comma-separated substrings. Only URLs containing one of INCLUDE are kept; EXCLUDE removes matches.
INCLUDE_PATTERNS=
EXCLUDE_PATTERNS=/tag/,/author/,/wp-json/,/cart/,/checkout/

# Chunking
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

# Retrieval
TOP_K=4
MIN_SCORE=0.30
VECTOR_STORE_PATH=data/vectors.json

# Answers
BOOKING_URL=https://example.com/book/
MAX_ANSWER_TOKENS=350

# Server
PORT=3001
# Comma-separated origins allowed to call /chat from a browser (your website)
ALLOWED_ORIGINS=http://localhost:3001,https://example.com
RATE_LIMIT_PER_MINUTE=10
